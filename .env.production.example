# =============================================================================
# 生产环境配置模板（.env.production.example）
#
# 使用方式（详见 docs/deploy.md「10 分钟路径」）：
#   cp .env.production.example .env.production
#   # 编辑下方「必改」三项密钥与管理员标识后：
#   docker compose --env-file .env.production up -d --build
#
# 红线（HC-08 / DC-13）：
#   1. 本文件仅占位密钥；.env.production 禁止提交版本库、禁止内嵌 compose 文件；
#   2. ENVIRONMENT=production 下三项弱密钥（API_ACCESS_TOKEN / POSTGRES_PASSWORD /
#      TOKEN_SIGNING_SECRET）命中黑名单即 fail-fast 拒绝启动（DC-05）——
#      占位值起不来是特性而非缺陷，必须先改真实值；
#   3. 其余未列变量回落 configuration/settings.py 默认值（全量清单见 .env.example）。
# =============================================================================

# ---------- 运行环境（必改项一：环境标识） ----------
# production：弱密钥 fail-fast + 生产日志口径
ENVIRONMENT=production

# ---------- 三项密钥（必改项二：全部换成真实强值） ----------
# 接口访问令牌（legacy 明文令牌；TOKEN_VERIFY_MODE=jwt 下仅作启动校验用途）
API_ACCESS_TOKEN=change-me-please
# PostgreSQL 凭据（与下方 POSTGRES_USER/POSTGRES_DB 配套）
POSTGRES_PASSWORD=change-me-please
# JWT 签名密钥：上线必改为 ≥32 字节随机值（openssl rand -base64 32）；
# 保管要求与 POSTGRES_PASSWORD 同级（docs/deploy.md「密钥保管」）
TOKEN_SIGNING_SECRET=change-me-token-secret

# ---------- API 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
# B15：compose 端口绑定面（docker-compose.yml 的 "${API_BIND_IP}:${API_PORT}:8000"）。
# 127.0.0.1=仅环回（单机演练/内网收紧）；默认 0.0.0.0=全网卡（注意暴露面）。
# 该值走 compose 插值通道，必须随 --env-file .env.production 一并提供——漏传
# --env-file 时插值回落 shell/.env 默认，出现「容器环境=本模板、端口=默认」
# 裂脑态（2026-11-25 compose drill 实测，详见批次 _drills/）。
API_BIND_IP=0.0.0.0

# ---------- 存储后端（生产走 postgres） ----------
STORAGE_BACKEND=postgres
# compose 网络内由编排文件覆写为服务名 postgres；独立部署时填实际主机名
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orchestration_platform
POSTGRES_USER=orchestration
# 本地文件落点（容器内路径；postgres 后端时仅作降级/缓存用途）
LOCAL_STORAGE_ROOT=/app/.data

# ---------- 生产三强化项（docs/deploy.md「生产必改清单」） ----------
# 令牌校验：jwt（仅 JWT；both 模式的明文回退在生产有残留风险，§7.1）
TOKEN_VERIFY_MODE=jwt
# 代码节点执行通道：subprocess（2.13 生产语义；inprocess 仅本地开发/单测通道）
CODE_EXECUTION_CHANNEL=subprocess
# 环境标识见上（ENVIRONMENT=production）

# ---------- JWT 签发端点（信任边界见 docs/deploy.md） ----------
# true：暴露 POST /api/v1/auth/token（面向内网/可信网关后调用）
AUTH_TOKEN_ISSUANCE_ENABLED=true

# ---------- RBAC 治理 ----------
# true：启用 RBAC 鉴权链（启用前先确认 bootstrap 已执行，DC-06：
# 仓储空时全部接口 403 是 fail-closed 正确行为，不是故障）
RBAC_ENABLED=true
# true：启动期幂等初始化（默认租户 → 内置角色 → 可选初始管理员绑定）；
# 首次部署与 RBAC_ENABLED 同时开启是安全的（bootstrap 在服务就绪前执行）
RBAC_BOOTSTRAP_ENABLED=true
# 初始管理员用户标识（必改项三：填入实际管理员账号，空则不创建管理员绑定，
# 首个管理员须后续手工授权）
RBAC_BOOTSTRAP_ADMIN_USER=

# ---------- 实例级步数护栏（G6） ----------
# true：实例轮次达到 workflow_max_steps 即 WF_BUDGET_EXCEEDED 阻断（防失控工作流）
WORKFLOW_STEP_GUARD_ENABLED=true
# 步数限额（默认 500；按业务上限调整）
WORKFLOW_MAX_STEPS=500

# ---------- 执行模式与队列（M2 worker 拓扑，docs/deploy.md §10） ----------
# worker：api 只入队，独立 worker 服务认领执行（docker-compose.yml worker 服务）；
# in_process（默认）：api 进程内执行，无 worker 服务亦可跑（历史行为）。
# 三个服务拓扑（api + worker + postgres）必须设 worker。
EXECUTION_MODE=worker
# 执行队列租约（秒）：认领即持租约，心跳续租；worker kill -9 后租约到期被接管
EXECUTION_QUEUE_LEASE_SECONDS=30
# 心跳续租间隔（秒）
EXECUTION_QUEUE_HEARTBEAT_SECONDS=10
# 认领轮询间隔（秒）
EXECUTION_QUEUE_POLL_INTERVAL_SECONDS=1.0
# 优雅停机宽限（秒）：SIGTERM 后停止认领，宽限期内等当前作业，超时停心跳留租约待接管
EXECUTION_QUEUE_GRACEFUL_SHUTDOWN_SECONDS=30

# ---------- LLM 主模型（Agent 节点依赖；填真实值后按需启用 LLM_NODE_ENABLED） ----------
LLM_PRIMARY_BASE_URL=https://api.example.com/v1
LLM_PRIMARY_API_KEY=change-me-please
LLM_PRIMARY_MODEL=primary-model-name
# 默认 false：关闭时 LLM 节点返回 LLM_NODE_DISABLED；填入真实模型配置后置 true
LLM_NODE_ENABLED=false

# ---------- 数据源（数据源节点依赖；无该类节点可留空） ----------
DATA_SOURCE_CONNECTION_STRING=change-me-please
