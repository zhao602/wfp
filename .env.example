# =============================================================================
# 环境变量配置模板（.env.example）
# 使用方式：复制为 .env 后填入真实值。禁止将真实密钥提交到版本库。
# 全部配置项由 config.py / configuration/settings.py 读取并做类型校验。
# =============================================================================

# ---------- API 服务 ----------
# 服务监听地址与端口（端口可配置，禁止硬编码）
API_HOST=0.0.0.0
API_PORT=8000
# 接口访问令牌：除 /healthz 外全部接口需携带 Authorization: Bearer <token>
API_ACCESS_TOKEN=change-me-please

# ---------- 存储后端 ----------
# 取值：local_file | postgres；纯验证场景可降级为本地文件
STORAGE_BACKEND=local_file
# 本地文件存储根目录
LOCAL_STORAGE_ROOT=./.data
# PostgreSQL 连接参数（STORAGE_BACKEND=postgres 时生效）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestration_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please

# ---------- 工作流定义约束 ----------
# 第一阶段节点数量上限
WORKFLOW_MAX_NODES=50

# ---------- 引擎调度约束 ----------
# 节点默认超时（秒）
NODE_DEFAULT_TIMEOUT_SECONDS=60
# 循环最大迭代次数（防死循环）
LOOP_MAX_ITERATIONS=10
# 长耗时节点中间检查点间隔（秒）
CHECKPOINT_INTERVAL_SECONDS=30
# 人工审核超时（秒）
REVIEW_TIMEOUT_SECONDS=3600
# 实例级超时（秒）
INSTANCE_TIMEOUT_SECONDS=1800
# 实例最大并发数
INSTANCE_MAX_CONCURRENCY=20

# ---------- LangGraph 适配层 ----------
# 检查点模式：memory | custom（custom 表示由平台仓储持久化）
LANGGRAPH_CHECKPOINTER_MODE=custom
# LangGraph 第二运行时开关（默认 false 零变化；true 时容器可构造第二运行时，
# 依赖缺失时降级内置引擎并告警；生产 start_instance 链路不受此开关影响）
LANGGRAPH_RUNTIME_ENABLED=false

# ---------- MCP 工具服务（仅客户端侧） ----------
MCP_SERVER_ENABLED=true
# 传输方式：stdio | http | sse
MCP_SERVER_TRANSPORT=http
MCP_SERVER_URL=http://localhost:9000/mcp
MCP_SERVER_COMMAND=change-me-mcp-server-command
MCP_SERVER_TIMEOUT_SECONDS=30
MCP_CONNECTION_POOL_MAX=10
MCP_CONNECTION_RETRY_MAX=3
MCP_TOOL_CACHE_TTL_SECONDS=300

# ---------- LLM 主模型 ----------
LLM_PRIMARY_BASE_URL=https://api.example.com/v1
LLM_PRIMARY_API_KEY=change-me-please
LLM_PRIMARY_MODEL=primary-model-name
LLM_PRIMARY_TIMEOUT_SECONDS=60

# ---------- LLM 备用模型（主模型失败时自动切换） ----------
LLM_FALLBACK_BASE_URL=https://api.example.com/v1
LLM_FALLBACK_API_KEY=change-me-please
LLM_FALLBACK_MODEL=fallback-model-name
LLM_FALLBACK_TIMEOUT_SECONDS=60

# ---------- LLM 推理重试（B2-C4；开关默认关闭，关闭时行为与现状一致） ----------
# 仅超时/连接失败等幂等失败重试；非 200 响应与其余异常不重试；退避 = 基数 * 2^n + 抖动
LLM_RETRY_ENABLED=false
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_BASE_SECONDS=0.5

# ---------- Agent 节点约束 ----------
# 单次执行内工具调用最大轮次（ReAct 循环上限）
AGENT_MAX_TOOL_ROUNDS=5
# 输出结构不合规时的最大重生成次数
AGENT_OUTPUT_MAX_RETRIES=2

# ---------- 大模型节点与代码节点（llm_code_nodes_v2） ----------
# 注意：修改 .env 后须重启后端进程（settings 使用 @lru_cache 缓存）
# 是否启用大模型节点（默认 false：关闭时节点执行返回 LLM_NODE_DISABLED）
LLM_NODE_ENABLED=false
# 是否启用代码节点（默认 false：关闭时节点执行返回 CODE_NODE_DISABLED）
CODE_NODE_ENABLED=false
# 代码节点受限执行超时（秒；默认 10，最小 1；与沙箱策略超时取较小值）
CODE_EXECUTION_TIMEOUT_SECONDS=10
# 代码节点输出序列化字节数上限（默认 1048576 即 1 MiB；与沙箱策略输出上限取较小值）
CODE_OUTPUT_MAX_BYTES=1048576
# 代码节点执行通道：inprocess（受限进程内执行，默认）/ subprocess（子进程；
# 非法取值由执行器降级为 inprocess 并告警）
CODE_EXECUTION_CHANNEL=inprocess

# ---------- 数据源 ----------
# 数据源连接串（只读，用于数据源节点）
DATA_SOURCE_CONNECTION_STRING=change-me-please

# ---------- 大数据连接器（MCP 数据集成） ----------
# Hologres 实时数仓
HOLOGRES_ENDPOINT=change-me-hologres-endpoint
HOLOGRES_PORT=80
HOLOGRES_DATABASE=change-me-database
HOLOGRES_ACCESS_ID=change-me-access-id
HOLOGRES_ACCESS_KEY=change-me-access-key
# Kafka 消息流
KAFKA_BROKERS=change-me-broker1:9092,broker2:9092
KAFKA_TOPIC=change-me-topic
KAFKA_GROUP_ID=orchestration_platform_consumer
KAFKA_OFFSET=earliest
# Flink 流计算引擎
FLINK_JOBMANAGER_URL=http://change-me-flink-host:8081
FLINK_JAR_ID=change-me-jar-id
# Spark 批计算引擎
SPARK_MASTER_URL=spark://change-me-spark-host:7077
SPARK_LIVY_URL=http://change-me-spark-host:8998
SPARK_APP_NAME=orchestration_platform_job

# ---------- 第三阶段治理配置 ----------
# RBAC 鉴权
# 本地开发默认关闭治理链：RBAC 与租户隔离须「同时」为 false，治理链才降级放行（本地免鉴权）；
# 生产部署必须显式启用治理（置 true），否则全部业务接口将免鉴权可访问。
RBAC_ENABLED=false
RBAC_PERMISSION_CACHE_TTL_SECONDS=300
# 租户隔离
TENANT_DEFAULT_QUOTA_MAX_INSTANCES=100
TENANT_DEFAULT_QUOTA_MAX_WORKFLOWS=1000
TENANT_ISOLATION_ENABLED=false
# 默认租户标识：业务仓储（workflow/event/checkpoint）tenant_id 缺省兜底，
# 与 v1_2 列默认值、种子租户一致（roadmap B1 多租户强隔离）
DEFAULT_TENANT_ID=tenant_default
# 令牌
TOKEN_DEFAULT_TTL_SECONDS=3600
TOKEN_SIGNING_SECRET=change-me-token-secret
# Token 计量
METERING_ENABLED=true
METERING_BUFFER_QUEUE_MAX_SIZE=10000
METERING_BUFFER_PERSIST_PATH=./.data/usage_buffer
# 计费
BILLING_COST_PRECISION=6
# 预算治理
BUDGET_CIRCUIT_BREAK_LATENCY_SECONDS=5
BUDGET_FAIL_CLOSED=true
# 告警
ALERT_CHANNEL_TYPE=webhook
ALERT_WEBHOOK_URL=change-me-alert-webhook-url
# 审计合规
AUDIT_ENABLED=true
AUDIT_WRITE_FAIL_STRATEGY=rollback
AUDIT_HASH_ALGORITHM=sha256
AUDIT_EXPORT_MAX_RECORDS=100000
AUDIT_EXPORT_FORMAT=json
AUDIT_MASK_DEFAULT_STRATEGY=full_mask
# 第五阶段（G5）：审计条目字段级内容哈希（默认关闭，开启后新条目写入 input_hash/output_hash）
AUDIT_CONTENT_HASH_ENABLED=false
# 第五阶段（G2）：结构化无损裁剪策略（默认关闭，开启后 STRUCTURAL_LOSSLESS 策略生效）
STRUCTURAL_LOSSLESS_PRUNING_ENABLED=false
# 第五阶段（G1）：监督者编排器（默认关闭，开启后 SUPERVISOR 节点类型可用）
SUPERVISOR_ORCHESTRATION_ENABLED=false
# 编排状态存储后端（memory=内存/local_file=本地文件/postgres=Postgres）
SUPERVISOR_ORCHESTRATION_STATE_BACKEND=memory
# 单编排子编排器数量上限
SUPERVISOR_ORCHESTRATION_MAX_SUB_ORCHESTRATORS=20
# 子任务失败最大重试次数
SUPERVISOR_SUB_TASK_RETRY_MAX=2
# 第五阶段（G6）：触发器模板（默认关闭，开启后三类异常检测模板可用）
TRIGGER_TEMPLATE_ENABLED=false
# 第五阶段（G3）：Agent 绩效记录与查询（默认关闭，开启后旁路记录并暴露查询路由）
AGENT_PERFORMANCE_ENABLED=false
# 内存绩效仓储环形窗口容量
AGENT_PERFORMANCE_MEMORY_WINDOW_SIZE=10000
# 全局调度
GLOBAL_SCHEDULER_ENABLED=true
GLOBAL_SCHEDULER_DECISION_TIMEOUT_MS=100
SCHEDULER_QUEUE_MAX_SIZE=10000
SCHEDULER_FAIR_WEIGHT_DEFAULT=1
SCHEDULER_PREEMPTION_ENABLED=true
SCHEDULER_PREEMPTION_MAX_COUNT=3
# 资源池
RESOURCE_POOL_CONCURRENCY_SLOT_QUOTA=100
RESOURCE_POOL_OVERSUBSCRIPTION_RATIO=1.0
RESOURCE_ESTIMATE_DEFAULT_SLOTS=1

# ---------- 可观测性 ----------
LOG_LEVEL=INFO

# ---------------- 运行日志（workflow_run_logging） ----------------
LOG_DIR=./logs
LOG_ROTATION_ENABLED=true
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_MAX_BYTES=52428800
LOG_RETENTION_DAYS=14
LOG_MAX_PAYLOAD_BYTES=65536
LOG_REDACTION_ENABLED=true
LOG_ASYNC_ENABLED=true
LOG_QUEUE_MAX_SIZE=10000
LOG_TENANT_DEFAULT=default

# ---------- 第二阶段新增：引擎增强 ----------
# 并行分支最大并行度
PARALLEL_BRANCH_MAX=10
# 并行默认失败策略：fast_fail | wait_all
PARALLEL_DEFAULT_STRATEGY=fast_fail
# 子工作流最大嵌套深度
SUBWORKFLOW_MAX_DEPTH=5
# 动态注入最大数量
DYNAMIC_INJECTION_MAX_COUNT=100
# 调度器批处理模式
SCHEDULER_BATCH_MODE=true
# 批处理单批最大节点数
SCHEDULER_BATCH_MAX_NODES=20
# 检查点压缩
CHECKPOINT_COMPRESSION_ENABLED=true
# 检查点压缩目标比率
CHECKPOINT_COMPRESSION_TARGET_RATIO=0.6

# ---------- 第四阶段：Agent 执行沙箱 ----------
# 是否启用沙箱（关闭则直通既有调用器）
SANDBOX_ENABLED=false
# 默认隔离模式：logical / physical
SANDBOX_DEFAULT_ISOLATION=logical
# 默认执行超时（秒）
SANDBOX_EXECUTION_TIMEOUT_SECONDS=60
# 默认 CPU 时间上限（秒）
SANDBOX_DEFAULT_CPU_SECONDS=10.0
# 默认内存上限（MB）
SANDBOX_DEFAULT_MEMORY_MB=512
# 默认输出尺寸上限（字节）
SANDBOX_DEFAULT_OUTPUT_BYTES=1048576
# 沙箱工作目录根
SANDBOX_WORKDIR_ROOT=./.data/sandbox/workdirs
# 网络默认拒绝
SANDBOX_NETWORK_DEFAULT_DENY=true
# 是否启用子进程隔离模式（默认关闭）
SANDBOX_SUBPROCESS_MODE=false
# 容器运行时端点（空则降级逻辑隔离）
SANDBOX_CONTAINER_ENDPOINT=
# 容器执行超时（秒）
SANDBOX_CONTAINER_TIMEOUT_SECONDS=120
# 违规事件 topic
SANDBOX_VIOLATION_TOPIC=sandbox_violations

# ---------- 第四阶段：插件/节点 SDK ----------
# 是否启用插件节点 SDK（关闭则不加载任何节点包）
PLUGIN_SDK_ENABLED=false
# 平台最大插件节点数
PLUGIN_SDK_MAX_NODES=200
# setup 阶段超时（秒）
PLUGIN_SDK_SETUP_TIMEOUT_SECONDS=30
# 插件节点包安装根目录
PLUGIN_SDK_PACKAGES_ROOT=./.data/plugin_packages

# ---------- 第四阶段：节点市场第三方贡献 ----------
# 是否启用节点市场第三方贡献（关闭则市场行为与既有版本完全一致）
NODE_CONTRIBUTION_ENABLED=false
# 签名算法（hmac-sha256 / rsa-sha256）
NODE_CONTRIBUTION_SIGNATURE_ALGORITHM=hmac-sha256
# 签名密钥（环境变量注入，空则拒绝提交）
NODE_CONTRIBUTION_SIGNATURE_SECRET=
# 静态安全扫描超时（秒）
NODE_CONTRIBUTION_SCAN_TIMEOUT_SECONDS=120
# 贡献存储根目录
NODE_CONTRIBUTION_STORAGE_ROOT=./.data/contributions

# ---------- 第四阶段：SSO 企业身份集成 ----------
# 是否启用 SSO（关闭则仅本地登录）
SSO_ENABLED=false
# SSO 会话 TTL（秒）
SSO_SESSION_TTL_SECONDS=3600
# 断言防重放缓存 TTL（秒）
SSO_ASSERTION_REPLAY_CACHE_TTL=300
# 属性缺失时缺省角色（空则拒绝开通）
SSO_DEFAULT_ROLE_ON_MISSING_ATTR=
# 凭据加密密钥（空则拒绝持久化凭据并告警）
CREDENTIAL_ENCRYPTION_KEY=

# ---------- 第四阶段：企业连接器 ----------
# 是否启用企业连接器（关闭则既有数据源能力不受影响）
ENTERPRISE_CONNECTOR_ENABLED=false
# 连接器默认超时（秒）
ENTERPRISE_CONNECTOR_DEFAULT_TIMEOUT_SECONDS=30
# 连接测试探活超时（秒）
ENTERPRISE_CONNECTOR_TEST_TIMEOUT_SECONDS=8

# ---------- 第四阶段：Agent 效能评估框架 ----------
# 是否启用评估框架（关闭则评估端点不暴露）
EVALUATION_ENABLED=false
# 是否启用 LLM 评分（默认纯规则评分）
EVALUATION_LLM_SCORING_ENABLED=false
# 固定随机种子（可复现）
EVALUATION_RANDOM_SEED=42
# LLM 评分温度
EVALUATION_LLM_TEMPERATURE=0.0
# 回归退化告警阈值
EVALUATION_REGRESSION_DEGRADE_THRESHOLD=0.05
# 场景集条目上限
EVALUATION_MAX_SCENARIOS=500

# ---------- 第四阶段：语义索引 Agent 发现 ----------
# 是否启用语义索引 Agent 发现（关闭则既有 hierarchical_delegation 行为不变）
AGENT_DISCOVERY_ENABLED=false
# 向量索引后端（空则纯关键词索引）
AGENT_DISCOVERY_VECTOR_BACKEND=
# 向量索引端点
AGENT_DISCOVERY_VECTOR_ENDPOINT=
# 向量索引超时（毫秒）
AGENT_DISCOVERY_VECTOR_TIMEOUT_MS=300
# 相关度阈值
AGENT_DISCOVERY_RELEVANCE_THRESHOLD=0.3
# 结果数量上限
AGENT_DISCOVERY_RESULT_LIMIT=10
# 最短查询长度
AGENT_DISCOVERY_MIN_QUERY_LENGTH=4
# 描述最大长度
AGENT_DISCOVERY_DESC_MAX_LENGTH=2000

# ---------- 向量知识库节点（vector_knowledge_base_node CHG-09） ----------
# 向量检索服务地址（api 模式 embedding/search/rerank 共用；空则 API 检索不可用，
# 实例执行报 NODE_VECTOR_RETRIEVAL_UNAVAILABLE）
VECTOR_KB_SEARCH_BASE_URL=
# 向量检索服务超时（秒）
VECTOR_KB_SEARCH_TIMEOUT_SECONDS=60
# 向量检索服务访问密钥（Bearer；仅 .env 注入，禁止写入工作流定义或日志）
VECTOR_KB_SEARCH_API_KEY=

# ---------- Agent 市场与 Tool 市场（agent_tool_marketplace） ----------
# 是否启用 Agent 市场（关闭时 /api/v1/agent-market/** 访问返回 404）
AGENT_MARKET_ENABLED=false
# Agent 市场条目存储根目录（本地文件后端）
AGENT_MARKET_STORAGE_ROOT=./.data/agent_market
# 是否启用 Tool 市场（关闭时 /api/v1/tool-market/** 访问返回 404）
TOOL_MARKET_ENABLED=false
# Tool 市场条目存储根目录（本地文件后端）
TOOL_MARKET_STORAGE_ROOT=./.data/tool_market

# ---------- 本地向量数据库（local_vector_database CHG-L16） ----------
# 是否启用本地向量数据库（默认 false：关闭时既有向量知识库节点行为完全不变）
LOCAL_VECTOR_DATABASE_ENABLED=false
# 存储根目录（一集合一文件 sqlite）
LOCAL_VECTOR_DATABASE_STORAGE_ROOT=./.data/vector_kb
# 默认向量维度
LOCAL_VECTOR_DATABASE_DEFAULT_DIMENSION=128
# 默认相似度度量（cosine / dot / euclidean）
LOCAL_VECTOR_DATABASE_DEFAULT_METRIC=cosine
# 增强检索后端标识（预留；空则暴力精确检索）
LOCAL_VECTOR_DATABASE_BACKEND=
# 查询超时（毫秒）
LOCAL_VECTOR_DATABASE_QUERY_TIMEOUT_MS=1000
# 单集合最大记录数
LOCAL_VECTOR_DATABASE_MAX_RECORDS_PER_COLLECTION=100000
# 单次检索 Top-K 上限
LOCAL_VECTOR_DATABASE_MAX_TOP_K=100
# 向量诚实化（B2-C5 / DC-B2-05，默认 false：关闭时写入行为与现状逐字节等价）
VECTOR_REAL_EMBEDDING_ENABLED=false
# 本地向量数据库存储路径（sqlite=存量默认；pg_array=可选 PostgreSQL 原生数组路径）
LOCAL_VECTOR_DATABASE_STORAGE=sqlite

# ---------- 向量知识库管理（vector_kb_management） ----------
# 是否启用向量知识库管理（默认 false：关闭时 /api/v1/kb-management/** 返回 404）
VECTOR_KB_MANAGEMENT_ENABLED=false
# 知识库元数据存储根目录（独立 sqlite3 落点）
VECTOR_KB_MANAGEMENT_STORAGE_ROOT=./.data/vector_kb_management
# 单文件大小上界（MB）
VECTOR_KB_MANAGEMENT_MAX_FILE_SIZE_MB=10
# 单知识库分片总量上界
VECTOR_KB_MANAGEMENT_MAX_CHUNKS_PER_KB=100000
# 默认分片长度上限（50..2000）
VECTOR_KB_MANAGEMENT_DEFAULT_CHUNK_LENGTH=500
# 默认相邻分片重叠长度
VECTOR_KB_MANAGEMENT_DEFAULT_OVERLAP=50
# 语义分块默认相似度阈值（仅 semantic）
VECTOR_KB_MANAGEMENT_DEFAULT_SIMILARITY_THRESHOLD=0.75

# ---------- 向量知识库写入模式（vkb_write_mode） ----------
# 写入模式待写入文本长度上界（字符数；仅约束写入模式；不新增独立节点开关，
# 写入生效依赖既有 VECTOR_KB_MANAGEMENT_ENABLED / LOCAL_VECTOR_DATABASE_ENABLED）
# 注意：修改 .env 后须重启后端进程（settings 使用 @lru_cache 缓存）
VECTOR_KB_WRITE_MAX_TEXT_LENGTH=500000

# ---------- 向量知识库文档标注（vkb_doc_annotation） ----------
# 是否启用文档标注能力（默认 false：关闭时标注端点返回 404，既有行为零变化）
VECTOR_KB_ANNOTATION_ENABLED=false
# 自定义标注项数上界
VECTOR_KB_ANNOTATION_MAX_ITEMS=32
# 自定义标注值长度上界（字符数）
VECTOR_KB_ANNOTATION_MAX_VALUE_LENGTH=512

# ---------- Agent 市场用户自主开发（agent_market_user_development） ----------
# 是否启用用户自主开发链路（默认 false：关闭时 /api/v1/agent-market/dev-* 访问返回 404）
AGENT_MARKET_DEV_ENABLED=false
# 开发提交存储根目录（提交 JSONL + 解压包落盘）
AGENT_MARKET_DEV_STORAGE_ROOT=./.data/agent_market_dev
# 提交包体大小上限（MB）
AGENT_MARKET_DEV_MAX_PACKAGE_MB=10
# 提交包文件数上限
AGENT_MARKET_DEV_MAX_FILES=200
# 提交包单文件大小上限（KB）
AGENT_MARKET_DEV_MAX_FILE_KB=2048
# manifest 元数据大小上限（KB）
AGENT_MARKET_DEV_MAX_MANIFEST_KB=64

# ---------- 安全强化（arch_review_v2_tasks G1/G2/G3，design §4.4 仅追加） ----------
# 运行环境：production 时三项弱密钥（API_ACCESS_TOKEN/POSTGRES_PASSWORD/
# TOKEN_SIGNING_SECRET）fail-fast 拒绝启动；development 仅告警不阻断
ENVIRONMENT=development
# 令牌校验三态：both（默认，JWT 优先 + 明文回退，存量令牌零失效）/
# jwt（仅 JWT，明文令牌拒绝）/ legacy（仅明文）
# 生产强制（roadmap B0/D2）：production 下仅允许 jwt，非 jwt 由启动强校验 fail-fast 拒绝启动
TOKEN_VERIFY_MODE=both
# JWT 受众校验值（aud 不匹配即拒）
TOKEN_AUDIENCE=orchestration-platform-api
# JWT 签发方校验值（iss 不匹配即拒）
TOKEN_ISSUER=orchestration-platform
# JWT exp 校验时钟偏移容忍（秒）
TOKEN_CLOCK_SKEW_SECONDS=60
# JWT 签发端点开关（默认 false：关闭时 POST /api/v1/auth/token 404）
AUTH_TOKEN_ISSUANCE_ENABLED=false
# RBAC 启动期幂等初始化开关（默认 false 不执行；开启前见 docs/deploy.md）
RBAC_BOOTSTRAP_ENABLED=false
# bootstrap 初始管理员用户标识（空则不创建初始管理员绑定）
RBAC_BOOTSTRAP_ADMIN_USER=

# ---- 事件总线与审计订阅（arch_review_v2_tasks_wave2 G1，CHG-59/DC-21/DC-22） ----
# 是否启用事件总线领域事件发布（默认关闭，基线零变化）
EVENT_BUS_PUBLISH_ENABLED=false
# 内存事件总线保留历史条数上限（仅在未启用 Kafka 时生效）
EVENT_BUS_MEMORY_HISTORY_MAX=10000
# 是否启用审计事件订阅落盘（默认关闭）
AUDIT_EVENT_SUBSCRIPTION_ENABLED=false

# ---- Cron 定时触发（arch_review_v2_tasks_wave2 G3，CHG-59/DC-28/DC-29） ----
# 是否启用 Cron 定时触发扫描器（默认关闭，基线零变化）
SCHEDULE_SCANNER_ENABLED=false
# 定时触发扫描间隔（秒）
SCHEDULE_SCANNER_INTERVAL_SECONDS=30
# 是否注册定时触发器管理路由（默认关闭，访问 404）
TRIGGER_SCHEDULE_API_ENABLED=false

# ---- 事件出口（roadmap B3，契约倒置 + 内存态 DLQ；详见 docs/event-export-guide.md） ----
# 是否启用事件出口 Webhook 投递装配（默认关闭，基线零变化）
EVENT_EXPORT_ENABLED=false
# 是否注册事件出口管理路由（订阅/死信/SSE，默认关闭，访问 404）
EVENT_EXPORT_API_ENABLED=false
# 单事件 Webhook 最大投递尝试次数
EVENT_EXPORT_WEBHOOK_MAX_ATTEMPTS=5
# 投递指数退避基数（秒）
EVENT_EXPORT_WEBHOOK_BACKOFF_BASE_SECONDS=1.0
# 投递退避上限（秒）
EVENT_EXPORT_WEBHOOK_BACKOFF_CAP_SECONDS=60.0
# 单次 Webhook 请求超时（秒）
EVENT_EXPORT_WEBHOOK_TIMEOUT_SECONDS=5.0
# 每订阅投递记录环形上限
EVENT_EXPORT_DELIVERY_HISTORY_MAX=1000
# 死信总量上限（超限丢最旧）
EVENT_EXPORT_DLQ_MAX_ENTRIES=1000
# 事件出口订阅持久化路径（roadmap B7 W3：变更后原子落盘、启动期恢复；重启保留订阅）
EVENT_EXPORT_SUBSCRIPTIONS_PERSIST_PATH=./.data/event_export/subscriptions.json
