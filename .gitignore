# =============================================================================
# 版本库忽略规则
# 关键点：.env 含真实密钥，必须忽略；运行期数据目录与各类缓存一并忽略。
# =============================================================================

# 环境变量（含密钥，禁止提交）
.env
# 生产环境变量（docker compose 部署时从 .env.production.example 复制，含真实密钥）
.env.production

# 运行期数据（本地文件存储后端产生）
.data/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.npm-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# 前端依赖与构建产物
node_modules/
web/dist/
web/coverage/
# Playwright e2e 运行产物（B8d：失败上下文/trace 归档不入库）
web/test-results/
web/playwright-report/

# IDE
.idea/
.vscode/
.codeartsdoer/
.arts/
.deveco/
.workbuddy/
.slidep/

# Windows / macOS 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 运行日志（FastAPI / 调度器等运行期产生）
logs/
*.log

# 运行时数据库文件（local_file / SQLite 持久化后端可能生成）
*.sqlite
*.sqlite3
*.db

# 前端工具缓存（TypeScript 增量构建 / Vite 依赖预构建）
*.tsbuildinfo
.vite/

# Python 测试与质量工具产物
.tox/
.hypothesis/
coverage.xml

# 临时与备份文件
*.bak
*.tmp
*.orig

output/
.merkle-snapshot.json
DEVELOPMENT.md